{
  "name": "plank",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plank – AI-arbeidsflate for FDV (forvaltning, drift og vedlikehold) på Cloudflare",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "predev": "node scripts/ensure-build.mjs",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev --port 8787 --local",
    "dev:api:remote": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply plank --local",
    "db:migrate:remote": "wrangler d1 migrations apply plank --remote",
    "preview": "npm run build && wrangler dev --port 8787 --local",
    "deploy": "npm run build && wrangler d1 migrations apply plank --remote && wrangler deploy",
    "mock:claude": "node scripts/mock-anthropic.mjs",
    "sample:ifc": "python3 scripts/make-sample-ifc.py",
    "cf-typegen": "wrangler types"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "hono": "^4.13.13",
    "lucide-react": "^1.54.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "web-ifc": "^0.0.78",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
