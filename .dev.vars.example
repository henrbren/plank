# Kopier til .dev.vars for lokal utvikling
APP_URL=http://localhost:5173
DEV_MODE=true
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=
ADMIN_EMAILS=henrik@vixon.no
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_PRO=
BOLIGMAPPA_CLIENT_ID=
BOLIGMAPPA_CLIENT_SECRET=
BOLIGMAPPA_TOKEN_HOST=
BOLIGMAPPA_API_BASE_URL=
# LAFT: i DEV_MODE=true brukes en lokal nøkkel. I prod: 32 byte base64 (openssl rand -base64 32)
LAFT_TOKEN_KEY=
