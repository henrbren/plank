# Kommune-kø hos boligmappa-ms (valgfritt – uten nøkkel ligger køen bare i Plank)
# BOLIGMAPPA_MS_URL=https://boligmappa-ms.laft.io
# BOLIGMAPPA_MS_KEY=
# Sett til http://localhost:8788 for å teste mot mock-Claude (npm run mock:claude)
# ANTHROPIC_BASE_URL=http://localhost:8788
